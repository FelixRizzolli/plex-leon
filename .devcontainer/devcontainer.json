{
  "name": "Plex Leon - Development Container",
  "dockerComposeFile": "./compose.yml",
  "service": "devcontainer",
  "shutdownAction": "none",

  "remoteUser": "root",
  "workspaceFolder": "/workspace",

  "postCreateCommand": "bash -lc 'poetry install && ln -snf \"$(poetry env info --path)\" .venv || true'",

  "mounts": [
    "type=bind,source=${env:SSH_AUTH_SOCK},target=/ssh-agent",
    "source=${localWorkspaceFolder}/.devcontainer/mounts/.jbdevcontainer/config,target=/.jbdevcontainer/config,type=bind",
    "source=${localWorkspaceFolder}/.devcontainer/mounts/.jbdevcontainer/JetBrains,target=/.jbdevcontainer/JetBrains,type=bind"
  ],

  "containerEnv": {
    "SSH_AUTH_SOCK": "/ssh-agent"
  },

  "forwardPorts": [6080, 5901],
  "portsAttributes": {
    "6080": {
      "label": "VNC web client (noVNC)",
      "onAutoForward": "silent"
    },
    "5901": {
      "label": "VNC TCP port",
      "onAutoForward": "silent"
    }
  },

  "customizations": {
    "vscode": {
      "extensions": [
        /* Vue & Tailwind CSS */
        "vue.volar",
        "bradlc.vscode-tailwindcss",

        /* Code Quality */
        "oxc.oxc-vscode",

        /* Testing */
        "vitest.explorer",
        "ms-playwright.playwright",

        /* Productivity */
        "GitHub.copilot",
        "GitHub.copilot-chat",
        "usernamehw.errorlens",
        "aaron-bond.better-comments",
        "gruntfuggly.todo-tree",
        "wix.vscode-import-cost",
        "mskelton.npm-outdated",

        /* Git */
        "eamodio.gitlens",
        "mhutchie.git-graph"
      ],
      "settings": {
        "files.autoSave": "afterDelay",
        "files.autoSaveDelay": 1000,
        "editor.formatOnSave": true
      }
    },
    "jetbrains": {
      "plugins": ["com.github.copilot"]
    }
  }
}
