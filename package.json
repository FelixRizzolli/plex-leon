{
  "name": "plex-leon",
  "version": "4.0.0",
  "description": "Electron app with Vue 3.6 Vapor Mode, Vite 8, TypeScript, Pinia",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "start": "bash scripts/start-display.sh",
    "start:dev": "bash scripts/start-display.sh dev",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "oxlint src electron tests",
    "lint:fix": "oxlint --fix src electron tests",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.28.2",
  "dependencies": {
    "pinia": "^3.0.4",
    "vue": "3.6.0-beta.7",
    "vue-router": "^5.0.3"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.4",
    "@vue/test-utils": "^2.4.6",
    "electron": "^40.6.1",
    "electron-vite": "^5.0.0",
    "jsdom": "^26.1.0",
    "oxlint": "^1.50.0",
    "typescript": "6.0.0-beta",
    "vite": "8.0.0-beta.16",
    "vitest": "^4.0.18"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["electron"],
    "overrides": {
      "vite": "8.0.0-beta.16"
    }
  }
}
