{
  "name": "plex-leon",
  "version": "4.0.0",
  "description": "Electron app with Vue 3.6 Vapor Mode, Vite 8, TypeScript, Pinia",
  "keywords": [],
  "license": "ISC",
  "author": "",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "start": "bash scripts/start-display.sh",
    "start:dev": "bash scripts/start-display.sh dev",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "oxlint src electron tests",
    "lint:fix": "oxlint --fix src electron tests",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json"
  },
  "dependencies": {
    "@dnd-kit/abstract": "^0.3.2",
    "@tabler/icons-vue": "^3.37.1",
    "@tailwindcss/vite": "^4.2.1",
    "@tanstack/vue-table": "^8.21.3",
    "@unovis/ts": "^1.6.4",
    "@unovis/vue": "^1.6.4",
    "@vueuse/core": "^14.2.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dnd-kit-vue": "^0.0.2",
    "lucide-vue-next": "^0.575.0",
    "pinia": "^3.0.4",
    "radix-vue": "^1.9.17",
    "reka-ui": "^2.8.2",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.1",
    "tw-animate-css": "^1.4.0",
    "vue": "3.6.0-beta.7",
    "vue-router": "^5.0.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^25.3.2",
    "@vitejs/plugin-vue": "^6.0.4",
    "@vue/test-utils": "^2.4.6",
    "electron": "^40.6.1",
    "electron-vite": "^5.0.0",
    "jsdom": "^26.1.0",
    "oxfmt": "^0.35.0",
    "oxlint": "^1.50.0",
    "typescript": "6.0.0-beta",
    "vite": "8.0.0-beta.16",
    "vitest": "^4.0.18"
  },
  "packageManager": "pnpm@10.28.2",
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron"
    ],
    "overrides": {
      "vite": "8.0.0-beta.16"
    }
  }
