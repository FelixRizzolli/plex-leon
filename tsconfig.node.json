{
  "compilerOptions": {
    "composite": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "target": "ES2022",
    "lib": ["ES2022"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "outDir": "out",
    "rootDir": ".",
    "types": ["node"],
    "paths": {
      "@main/*": ["./electron/main/*"],
      "@preload/*": ["./electron/preload/*"]
    }
  },
  "include": ["electron/**/*.ts", "electron.vite.config.ts"]
}
